		<item>
		<title>Jordan Peterson&#8217;s zombie climate ideas</title>
		<link>https://www.danolner.net/2022/08/jordan-petersons-zombie-climate-ideas</link>
		
		<dc:creator><![CDATA[dan]]></dc:creator>
		<pubDate>Thu, 25 Aug 2022 12:45:18 +0000</pubDate>
