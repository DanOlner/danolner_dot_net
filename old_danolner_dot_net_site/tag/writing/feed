	<item>
		<title>List of UK sci-fi-friendly literary agents (and some pitching tips)</title>
		<link>https://www.danolner.net/2023/01/list-of-uk-sci-fi-friendly-literary-agents</link>
		
		<dc:creator><![CDATA[dan]]></dc:creator>
